# Reduced elastic network; no contact, damage or chemical kinetics.
# Run using python -m oxt.lammps_export, not bare lmp: exact angular callback required.
# Validate signed junction orientations in every saved frame before fitting.
include colVII_none.base.in
min_style fire
minimize 0 1e-10 20000 200000
reset_timestep 0
velocity all create 1.0000000000000001e-30 4928 dist gaussian
fix integrate all nve
fix shear all deform 1 xy wiggle 0.55425625842204074 200 remap v flip no
compute peculiar all temp/deform
fix drag all langevin 0 0 1 48279 tally yes zero yes
fix_modify drag temp peculiar
variable clock equal time
fix sample all print 10 "$(time:%.17g) $(v_gamma:%.17g) $(v_sxy:%.17g) $(pe:%.17g) $(f_gag:%.17g) $(f_drag:%.17g)" file colVII_none_stress.txt screen no title "time gamma sigma_config potential tether_energy thermostat_exchange"
dump trajectory all custom 10 colVII_none.dump id xu yu fx fy
thermo 100
timestep 0.01
run 100000
