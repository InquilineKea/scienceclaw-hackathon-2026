; Pilot minimization. No adduct or covalent crosslink parameters.
integrator = steep
nsteps = 5000
emtol = 1000
emstep = 0.005
cutoff-scheme = Verlet
nstlist = 20
coulombtype = PME
rcoulomb = 1.0
rvdw = 1.0
vdw-modifier = Potential-shift
DispCorr = EnerPres
constraints = h-bonds
constraint-algorithm = lincs
pbc = xyz
nstenergy = 100
