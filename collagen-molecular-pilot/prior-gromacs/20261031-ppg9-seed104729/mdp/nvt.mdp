; Restrained 10 ps commissioning stage; not adequate evidence of equilibration.
define = -DPOSRES
integrator = md
dt = 0.001
nsteps = 10000
continuation = no
cutoff-scheme = Verlet
nstlist = 20
coulombtype = PME
rcoulomb = 1.0
rvdw = 1.0
vdw-modifier = Potential-shift
DispCorr = EnerPres
constraints = h-bonds
constraint-algorithm = lincs
lincs-order = 4
pbc = xyz
tcoupl = V-rescale
tc-grps = System
tau-t = 0.5
ref-t = 300
pcoupl = no
gen-vel = yes
gen-temp = 300
gen-seed = 104729
ld-seed = 104729
nstenergy = 100
nstlog = 100
nstxout-compressed = 1000
compressed-x-grps = System
