; Restrained 20 ps density relaxation; too short to establish equilibrium.
define = -DPOSRES
integrator = md
dt = 0.001
nsteps = 20000
continuation = yes
cutoff-scheme = Verlet
nstlist = 20
coulombtype = PME
rcoulomb = 1.0
rvdw = 1.0
vdw-modifier = Potential-shift
DispCorr = EnerPres
constraints = h-bonds
constraint-algorithm = lincs
lincs-order = 4
pbc = xyz
tcoupl = V-rescale
tc-grps = System
tau-t = 0.5
ref-t = 300
pcoupl = C-rescale
pcoupltype = isotropic
tau-p = 5.0
ref-p = 1.0
compressibility = 4.5e-5
refcoord-scaling = com
gen-vel = no
ld-seed = 130363
nstenergy = 100
nstlog = 100
nstxout-compressed = 1000
compressed-x-grps = System
